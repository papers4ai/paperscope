[{"id":"openalex:W7219783533","title":"Transmembrane PhoxID: photoproximity labelling across the plasma membrane in vivo","authors":["Fátima Yuri Tanimura Valor","Mikiko Takato","Ayane Araki","Seiji Sakamoto","Tomonori Tamura","Itaru Hamachi"],"published":"2026-10-05","year":2026,"month":10,"pdf_url":"https://doi.org/10.1038/s41467-026-78135-2","has_code":false,"type":"Method","_domains":["world_model"],"_tasks":[],"venue":"Nature Communications","venue_tier":"T1","citation_count":1},{"id":"openalex:W7220387322","title":"The more you automate, the less you see: Hidden pitfalls of autonomous AI scientists","authors":["Ziming Luo","Atoosa Kasirzadeh","Nihar B. Shah"],"published":"2026-10-05","year":2026,"month":10,"pdf_url":"https://doi.org/10.1073/pnas.2610214123","has_code":false,"type":"Survey","_domains":["medical_ai","world_model"],"_tasks":[],"_topics":["autonomous ai scientists","research lifecycle automation"],"venue":"PNAS","venue_tier":"T1","citation_count":0,"summary_zh":"本文分析开源AI科学家系统，揭示自动化科学研究的潜在缺陷。发现不当基准选择、数据泄露、指标误用和后验选择偏差等问题。","summary_en":"This paper analyzes open-source AI scientist systems, revealing hidden pitfalls of automated scientific research. Issues such as inappropriate benchmark selection, data leakage, metric misuse, and post hoc selection bias are found.","insights":["创新点：揭示自动化科学研究的潜在缺陷","方法亮点：分析开源AI科学家系统","关键发现：发现多种潜在缺陷"],"insights_en":["Novelty: Revealing hidden pitfalls of automated scientific research","Method highlight: Analyzing open-source AI scientist systems","Key finding: Discovering various potential pitfalls"],"abstract":"The rapid rise of autonomous AI scientists marks a paradigm shift in scientific discovery by automating the research lifecycle. Yet their rushed development has outpaced critical oversight, leaving key workflow decisions dangerously unscrutinized. We present a much-needed systematic analysis of open-source AI scientist systems, investigating four primary pitfalls: inappropriate benchmark selection, data leakage, metric misuse, and post hoc selection bias. Through controlled experiments that isolate each pitfall, we find systematic vulnerabilities across two representative open-source systems. Crucially, we find that these flaws are largely invisible at the level of the final manuscript, suggesting that current manuscript-centric peer review paradigms are fundamentally insufficient for ensuring the integrity of automated research. We further propose mitigation strategies and demonstrate that access to full workflow artifacts (log traces and code) enables more effective auditing. Our findings suggest that journals, conferences, and researchers should move beyond manuscript-only evaluation toward process auditing the end-to-end workflow artifacts of AI scientist systems."},{"id":"openalex:W7215029252","title":"DLCL: Deep Learning-Enabled Cooperative Localization for UAV-UGV Team with Adaptive Perception Recovery","authors":["Veera Venkata Ram Murali Krishna Rao Muvva","Yogesh Chawla","Kunjan Theodore Joseph","Ankita Kalra","Marilyn C. Wolf","Santosh Kumar Pitla"],"published":"2026-10-01","year":2026,"month":10,"has_code":false,"type":"Method","_domains":["world_model"],"_tasks":[],"venue":"IJCV","venue_tier":"T1","citation_count":0},{"id":"openalex:W7215035483","title":"Shifting from knowledge retrieval to evidence exploration and synthesis","authors":["Shruti Shikhare","Jake Cohen-Setton","Krishna C. Bulusu"],"published":"2026-10-01","year":2026,"month":10,"has_code":false,"type":"Method","_domains":["world_model"],"_tasks":[],"venue":"Nature Machine Intelligence","venue_tier":"T1","citation_count":0},{"id":"openalex:W7215073662","title":"Large language models discover complementary heuristics for combinatorial optimization","authors":["Huatian Gong","Shuaian Wang","Dong‐Ping Song","Jiuh‐Biing Sheu","Ran Yan"],"published":"2026-10-01","year":2026,"month":10,"has_code":false,"type":"Method","_domains":["world_model"],"_tasks":["FoundationModel"],"venue":"Nature Machine Inte